#!/usr/bin/env python3
"""Publishes pose changes in the tool frame and ~alignment at 50 Hz.

The search alternates its steps, as the old node did: ~proposed_turn (tilt to level the
contact, no sideways move) and ~proposed_move (sideways towards the loaded side, no tilt). Both
also move along the axis towards the target load. The old node published both on one topic, so
a caller got whichever came next; separate topics let the demo alternate on purpose. When the
contact is already level the turn is undefined (NaN in the old code) and nothing is published
on ~proposed_turn.

Each proposal is stamped with the time of the cap sample it was computed from (the bridge's
stamp), so a caller can wait for one from after its last move (S6, 2026-11-12). Stops
publishing when /cap_data is older than STALE_S, so a stale proposal can't be used.
The old node kept publishing its last numbers. Parameters: frame (the tool's TCP link),
calibration (capcup_calibration.yaml whose gains the search uses; "" = none, the old behaviour).
Service ~/rezero (std_srvs/Trigger): the mean of the next REZERO_SAMPLES cap samples becomes the
in-air zero; no proposals or alignment until then. Call it with the cup in free air.
"""
import rclpy
from capcup_interfaces.msg import CapData
from geometry_msgs.msg import PoseStamped
from rclpy.qos import qos_profile_sensor_data
from std_msgs.msg import Bool
from std_srvs.srv import Trigger

from capcup_driver import calibration as cal
from capcup_driver.haptic import HapticSearch

REZERO_SAMPLES = 3   # ~0.5 s at the board's 5.8 Hz; one sample's noise is ~+-600 counts
STALE_S = 0.5   # the board sends every 0.171 s (S6, 2026-11-12; 0.2 s left 29 ms)


def main():
    rclpy.init()
    node = rclpy.create_node("haptic_search")
    frame = node.declare_parameter("frame", "gripper_equilibrium_grasp").value
    path = node.declare_parameter("calibration", "").value
    gains = cal.load(path)["gains"] if path else None
    search = HapticSearch(gains=gains)
    node.get_logger().info(
        f"gains {'from ' + path + ': ' + str(gains) if gains else 'off (raw counts)'}; thresholds "
        f"lo {search._thresh_lo:g} (sum), hi {search._thresh_hi:g} (any channel), "
        f"aligned {search._thresh_lo / 8:g} (every channel)")
    last, sample = [None], [None]
    turn_pub = node.create_publisher(PoseStamped, "~/proposed_turn", 1)
    move_pub = node.create_publisher(PoseStamped, "~/proposed_move", 1)
    aligned_pub = node.create_publisher(Bool, "~/alignment", 1)

    rezero = {"buf": None}

    def on_rezero(_, response):
        rezero["buf"] = []
        node.get_logger().info(f"re-zero: averaging the next {REZERO_SAMPLES} samples")
        response.success = True
        return response

    node.create_service(Trigger, "~/rezero", on_rezero)

    def on_data(m):
        if rezero["buf"] is not None:
            rezero["buf"].append(list(m.values))
            if len(rezero["buf"]) < REZERO_SAMPLES:
                return
            search.rezero(rezero["buf"])
            rezero["buf"] = None
            node.get_logger().info("re-zeroed")
        search.update(m.device_time_s, m.values)
        last[0] = node.get_clock().now()
        sample[0] = m.header.stamp

    def tick():
        now = node.get_clock().now()
        if last[0] is None or (now - last[0]).nanoseconds * 1e-9 > STALE_S:
            return
        proposal = search.step()
        if proposal is not None:
            t, q = proposal
            msg = PoseStamped()
            msg.header.stamp = sample[0]
            msg.header.frame_id = frame
            p, o = msg.pose.position, msg.pose.orientation
            p.x, p.y, p.z = map(float, t)
            o.x, o.y, o.z, o.w = map(float, q)
            (turn_pub if search.last_was_turn else move_pub).publish(msg)
        aligned = search.aligned()
        if aligned is not None:
            aligned_pub.publish(Bool(data=aligned))

    node.create_subscription(CapData, "/cap_data", on_data, qos_profile_sensor_data)
    node.create_timer(0.02, tick)
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException):
        pass


if __name__ == "__main__":
    main()
