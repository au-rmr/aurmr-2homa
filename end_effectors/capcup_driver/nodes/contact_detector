#!/usr/bin/env python3
"""Publishes /cap_contact for every /cap_data sample (50 Hz from the board).

Every sample, not only on change as the old node did: motion_server treats a stop signal that
goes quiet for 100 ms as stale. The cup must be untouched when this starts (first sample = zero).
Parameters: threshold, time_constant_s.
"""
import rclpy
from capcup_interfaces.msg import CapData
from rclpy.qos import qos_profile_sensor_data
from std_msgs.msg import Bool

from capcup_driver.touch import TouchDetector


def main():
    rclpy.init()
    node = rclpy.create_node("contact_detector")
    detector = TouchDetector(node.declare_parameter("time_constant_s", 10.0).value,
                             node.declare_parameter("threshold", 10000.0).value)
    pub = node.create_publisher(Bool, "/cap_contact", qos_profile_sensor_data)
    node.create_subscription(
        CapData, "/cap_data",
        lambda m: pub.publish(Bool(data=detector.update(m.device_time_s, m.values))),
        qos_profile_sensor_data)
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException):
        pass


if __name__ == "__main__":
    main()
