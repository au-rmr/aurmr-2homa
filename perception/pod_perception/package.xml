<?xml version="1.0"?>
<package format="3">
  <name>pod_perception</name>
  <version>0.1.0</version>
  <description>Pod perception node: which item is in which bin (bin_tracker + uois) and suction grasps (optigrasp).</description>
  <maintainer email="choialex@uw.edu">Alex Choi</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>perception_interfaces</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
