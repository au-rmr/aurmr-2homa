<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface address="${ROBOT_LAN_IP}" priority="default" multicast="default"/>
      </Interfaces>
    </General>
    <Internal>
      <!-- max: needs docker/host/60-ros2-dds.conf on the host for large messages (camera images); min stays low so a host without it still starts -->
      <SocketReceiveBufferSize min="2MB" max="256MB"/>
    </Internal>
  </Domain>
  <!-- Camera domain (77): high-rate images between processes on one host only (Kinect driver -> perception node),
       loopback, never the robot LAN. Perception bridges by joining both domains (perception/pod_perception). -->
  <Domain Id="77">
    <General>
      <Interfaces>
        <NetworkInterface address="127.0.0.1" priority="default" multicast="default"/>
      </Interfaces>
    </General>
  </Domain>
</CycloneDDS>
