<?xml version="1.0"?>
<package format="3">
  <name>optigrasp_demo</name>
  <version>0.1.0</version>
  <description>The optigrasp demo: stow items by hand while perception tracks them, then pick an item by id with a vision grasp.</description>
  <maintainer email="choialex@uw.edu">Alex Choi</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>perception_interfaces</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
