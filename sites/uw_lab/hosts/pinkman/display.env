# X display for the Isaac viewer on pinkman: the desktop session of the shared lab user aurmr (uid 1002, GDM).
# Log in to the desktop as aurmr first; check the display number with `ls /tmp/.X11-unix` (other users' sessions
# take :1, :2...). Host path of the Xauthority file.
DISPLAY=:3
XAUTHORITY_HOST=/run/user/1002/gdm/Xauthority
